<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Post Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    :root {
      --bg: #0f172a;
      --card: #1e2937;
      --accent: #a855f7;
      --text: #e2e8f0;
      --muted: #94a3b8;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', system-ui, sans-serif;
      padding: 40px 20px;
      min-height: 100vh;
    }

    .post-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .post-header h1 {
      color: var(--accent);
      font-size: 2.8rem;
      font-weight: 700;
    }

    .post-id {
      color: #64748b;
      font-size: 1.1rem;
    }

    .main-container {
      background: var(--card);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      max-width: 1100px;
      margin: 0 auto;
    }

    .post-content {
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
      align-items: flex-start;
    }

    .post-image {
      flex: 1;
      min-width: 300px;
    }

    .post-image img {
      width: 100%;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      transition: transform 0.4s ease;
    }

    .post-image img:hover {
      transform: scale(1.03);
    }

    .post-info {
      flex: 1;
      min-width: 300px;
    }

    .info-item {
      background: #334155;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .info-label {
      color: var(--muted);
      font-weight: 500;
    }

    .info-value {
      color: white;
      font-weight: 600;
    }

    .username {
      font-size: 2rem;
      color: #22d3ee;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .button-group {
      margin-top: 40px;
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      justify-content: center;
    }

    .btn-custom {
      padding: 14px 28px;
      border-radius: 50px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.3s;
    }

    .btn-edit { background: #8b5cf6; border: none; }
    .btn-delete { background: #ef4444; border: none; }
    .btn-chat { background: #06b6d4; border: none; }

    .btn-custom:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body>

  <div class="post-header">
    <h1>Post Details</h1>
    <p class="post-id">Post ID: <strong><%= post.id %></strong></p>
  </div>

  <div class="main-container">
    <div class="post-content">

      <!-- Image Section -->
      <div class="post-image">
        <img src="<%= post.img %>" alt="Post Image" onerror="this.src='https://via.placeholder.com/600x400?text=No+Image'">
      </div>

      <!-- Information Section -->
      <div class="post-info">
        <div class="username">
          <i class="fas fa-user"></i> @<%= post.username %>
        </div>

        <div class="info-item">
          <span class="info-label">Content</span>
          <span class="info-value"><%= post.content %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Number</span>
          <span class="info-value"><%= post.Number %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Age</span>
          <span class="info-value"><%= post.age %></span>
        </div>
        <div class="info-item">
          <span class="info-label">City</span>
          <span class="info-value"><%= post.city %></span>
        </div>
        <div class="info-item">
          <span class="info-label">District</span>
          <span class="info-value"><%= post.district %></span>
        </div>
        <div class="info-item">
          <span class="info-label">State</span>
          <span class="info-value"><%= post.state %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Country</span>
          <span class="info-value"><%= post.country %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Date of Birth</span>
          <span class="info-value"><%= post.dob %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Hostel</span>
          <span class="info-value"><%= post.hostel %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Study</span>
          <span class="info-value"><%= post.study %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Hobby</span>
          <span class="info-value"><%= post.hobby %></span>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="button-group">
      <a href="/posts/<%= post.id %>/edit">
        <button class="btn btn-custom btn-edit">
          <i class="fas fa-edit"></i> Edit Post
        </button>
      </a>

      <form method="POST" action="/posts/<%= post.id %>?_method=DELETE" style="display: inline;">
        <button class="btn btn-custom btn-delete" onclick="return confirm('Are you sure you want to delete this post?')">
          <i class="fas fa-trash"></i> Delete
        </button>
      </form>

      <a href="/posts/<%= post.id %>/chat">
        <button class="btn btn-custom btn-chat">
          <i class="fas fa-comments"></i> Open Chat
        </button>
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>