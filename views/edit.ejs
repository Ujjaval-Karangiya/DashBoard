<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      padding: 30px 15px;
    }

    .edit-container {
      background: #1e2937;
      border-radius: 20px;
      padding: 40px;
      max-width: 900px;
      margin: 0 auto;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .page-title {
      text-align: center;
      color: #22d3ee;
      font-size: 2.4rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .post-info {
      text-align: center;
      background: #334155;
      padding: 12px 20px;
      border-radius: 12px;
      margin-bottom: 30px;
      font-size: 1.1rem;
    }

    label {
      color: #c4d0ff;
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
    }

    .form-control {
      background: #334155;
      border: none;
      color: #e2e8f0;
      padding: 12px 16px;
      border-radius: 12px;
    }

    .form-control:focus {
      background: #475569;
      box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.3);
      color: white;
    }

    .btn-update {
      width: 100%;
      padding: 16px;
      font-size: 1.15rem;
      font-weight: 600;
      border-radius: 12px;
      margin-top: 30px;
      background: #22d3ee;
      color: #0f172a;
      border: none;
      transition: all 0.3s;
    }

    .btn-update:hover {
      background: #67e8f9;
      transform: translateY(-3px);
    }
  </style>
</head>
<body>

  <div class="edit-container">
    <h1 class="page-title">
      <i class="fas fa-edit"></i> Edit Post
    </h1>
    
    <div class="post-info">
      <strong>Post ID:</strong> <%= post.id %> &nbsp;&nbsp;|&nbsp;&nbsp; 
      <strong>Username:</strong> @<%= post.username %>
    </div>

    <form method="POST" action="/posts/<%= post.id %>?_method=patch">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="content">Content</label>
            <textarea class="form-control" name="content" id="content" rows="4" required><%= post.content %></textarea>
          </div>

          <div class="mb-3">
            <label for="Number">Phone Number</label>
            <input type="text" class="form-control" name="Number" id="Number" value="<%= post.Number %>">
          </div>

          <div class="mb-3">
            <label for="age">Age</label>
            <input type="number" class="form-control" name="age" id="age" value="<%= post.age %>">
          </div>

          <div class="mb-3">
            <label for="city">City</label>
            <input type="text" class="form-control" name="city" id="city" value="<%= post.city %>">
          </div>

          <div class="mb-3">
            <label for="district">District</label>
            <input type="text" class="form-control" name="district" id="district" value="<%= post.district %>">
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <label for="state">State</label>
            <input type="text" class="form-control" name="state" id="state" value="<%= post.state %>">
          </div>

          <div class="mb-3">
            <label for="country">Country</label>
            <input type="text" class="form-control" name="country" id="country" value="<%= post.country %>">
          </div>

          <div class="mb-3">
            <label for="dob">Date of Birth</label>
            <input type="date" class="form-control" name="dob" id="dob" value="<%= post.dob %>">
          </div>

          <div class="mb-3">
            <label for="hostel">Hostel</label>
            <input type="text" class="form-control" name="hostel" id="hostel" value="<%= post.hostel %>">
          </div>

          <div class="mb-3">
            <label for="study">Study / Course</label>
            <input type="text" class="form-control" name="study" id="study" value="<%= post.study %>">
          </div>

          <div class="mb-3">
            <label for="hobby">Hobby</label>
            <input type="text" class="form-control" name="hobby" id="hobby" value="<%= post.hobby %>">
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-update">
        <i class="fas fa-save"></i> Update Post
      </button>
    </form>

    <div class="text-center mt-4">
      <a href="/posts/<%= post.id %>" class="text-muted">? Cancel & Back to Post</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>