<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard Home</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body{
      background:#f4f7fc;
      overflow-x:hidden;
    }

    .navbar{
      background:#111827;
      padding:15px 40px;
    }

    .navbar-brand{
      color:#fff !important;
      font-size:28px;
      font-weight:bold;
    }

    .nav-link{
      color:#d1d5db !important;
      margin-left:20px;
      transition:0.3s;
    }

    .nav-link:hover{
      color:#fff !important;
    }

    .hero{
      min-height:90vh;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      background:linear-gradient(135deg,#2563eb,#7c3aed);
      color:white;
      padding:40px;
    }

    .hero h1{
      font-size:60px;
      font-weight:700;
      margin-bottom:20px;
    }

    .hero p{
      font-size:20px;
      max-width:700px;
      margin:auto;
      margin-bottom:30px;
    }

    .hero .btn{
      padding:12px 28px;
      font-size:18px;
      border-radius:10px;
      margin:10px;
    }

    .features{
      padding:80px 20px;
    }

    .feature-card{
      background:white;
      border-radius:20px;
      padding:30px;
      box-shadow:0 5px 20px rgba(0,0,0,0.08);
      transition:0.3s;
      height:100%;
    }

    .feature-card:hover{
      transform:translateY(-10px);
    }

    .feature-icon{
      font-size:45px;
      margin-bottom:20px;
    }

    footer{
      background:#111827;
      color:white;
      text-align:center;
      padding:20px;
      margin-top:50px;
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">DashBoard</a>

      <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/posts">Posts</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/chat">Chat</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/new">Create</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div>
      <h1>Modern Dashboard Website</h1>

      <p>
        Manage posts, chats, users, and analytics with a clean and modern dashboard UI built using Node.js, Express, and EJS.
      </p>

      <a href="/posts" class="btn btn-light">Explore</a>
      <a href="/new" class="btn btn-dark">Create Post</a>
    </div>
  </section>

  <!-- Features -->
  <section class="features container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Features</h2>
      <p class="text-muted">Everything you need in one dashboard</p>
    </div>

    <div class="row g-4">

      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-icon">??</div>
          <h4>Analytics</h4>
          <p>
            Track performance and monitor your application data easily.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-icon">??</div>
          <h4>Chat System</h4>
          <p>
            Real-time style messaging interface with clean UI components.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card text-center">
          <div class="feature-icon">?</div>
          <h4>Fast Performance</h4>
          <p>
            Lightweight backend with Express and MongoDB integration.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2026 Dashboard Project | Built with Node.js & EJS</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>