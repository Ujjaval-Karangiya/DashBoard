<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create New Chat</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .form-container {
      background: #1e2937;
      padding: 40px 35px;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      max-width: 520px;
      width: 100%;
    }

    .form-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .form-header h1 {
      color: #a855f7;
      font-size: 2.3rem;
      font-weight: 700;
    }

    .form-header p {
      color: #94a3b8;
      margin: 0;
    }

    label {
      color: #c4d0ff;
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
    }

    .form-control {
      background: #334155;
      border: none;
      color: #e2e8f0;
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 1rem;
    }

    .form-control:focus {
      background: #475569;
      color: white;
      box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.3);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 120px;
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 12px;
      margin-top: 25px;
      background: #a855f7;
      border: none;
      transition: all 0.3s;
    }

    .btn-submit:hover {
      background: #9333ea;
      transform: translateY(-3px);
    }
  </style>
</head>
<body>

  <div class="form-container">
    <div class="form-header">
      <h1><i class="fas fa-comment-dots"></i> New Chat</h1>
      <p>Send a message to start a conversation</p>
    </div>

    <form action="/posts/chat" method="post">
      <div class="mb-3">
        <label for="from"><i class="fas fa-user"></i> From (Your Name)</label>
        <input type="text" class="form-control" name="from" id="from" placeholder="Enter your name" required>
      </div>

      <div class="mb-3">
        <label for="to"><i class="fas fa-arrow-right"></i> To (Receiver)</label>
        <input type="text" class="form-control" name="to" id="to" placeholder="Who are you sending to?" required>
      </div>

      <div class="mb-3">
        <label for="msg"><i class="fas fa-message"></i> Message</label>
        <textarea class="form-control" name="msg" id="msg" rows="5" 
                  placeholder="Write your message here..." required></textarea>
      </div>

      <button type="submit" class="btn btn-primary btn-submit">
        <i class="fas fa-paper-plane"></i> Send Message
      </button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>