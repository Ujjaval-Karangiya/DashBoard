<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create New Post</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      padding: 30px 15px;
    }

    .form-container {
      background: #1e2937;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      max-width: 900px;
      margin: 0 auto;
    }

    .form-header {
      text-align: center;
      margin-bottom: 35px;
    }

    .form-header h1 {
      color: #22d3ee;
      font-size: 2.4rem;
      font-weight: 700;
    }

    label {
      color: #c4d0ff;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .form-control {
      background: #334155;
      border: none;
      color: #e2e8f0;
      padding: 12px 16px;
      border-radius: 12px;
    }

    .form-control:focus {
      background: #475569;
      box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.3);
      color: white;
    }

    .btn-submit {
      width: 100%;
      padding: 16px;
      font-size: 1.15rem;
      font-weight: 600;
      border-radius: 12px;
      margin-top: 30px;
      background: #22d3ee;
      color: #0f172a;
      border: none;
      transition: all 0.3s;
    }

    .btn-submit:hover {
      background: #67e8f9;
      transform: translateY(-3px);
    }

    .row .col-md-6 {
      margin-bottom: 20px;
    }
  </style>
</head>
<body>

  <div class="form-container">
    <div class="form-header">
      <h1><i class="fas fa-plus-circle"></i> Create New Post</h1>
      <p class="text-muted">Fill in the details below</p>
    </div>

    <form method="POST" action="/posts/new">
      <div class="row">
        <!-- Left Column -->
        <div class="col-md-6">
          <div class="mb-3">
            <label for="username">Username</label>
            <input type="text" class="form-control" id="username" name="username" placeholder="Enter username" required>
          </div>

          <div class="mb-3">
            <label for="content">Content</label>
            <textarea class="form-control" id="content" name="content" rows="4" 
                      placeholder="Write your post content..." required></textarea>
          </div>

          <div class="mb-3">
            <label for="img">Image URL</label>
            <input type="text" class="form-control" id="img" name="img" placeholder="https://example.com/image.jpg">
          </div>

          <div class="mb-3">
            <label for="Number">Phone Number</label>
            <input type="text" class="form-control" id="Number" name="Number" placeholder="Enter phone number">
          </div>
        </div>

        <!-- Right Column -->
        <div class="col-md-6">
          <div class="mb-3">
            <label for="age">Age</label>
            <input type="number" class="form-control" id="age" name="age" placeholder="Your age">
          </div>

          <div class="mb-3">
            <label for="city">City</label>
            <input type="text" class="form-control" id="city" name="city" placeholder="Enter city">
          </div>

          <div class="mb-3">
            <label for="district">District</label>
            <input type="text" class="form-control" id="district" name="district" placeholder="Enter district">
          </div>

          <div class="mb-3">
            <label for="state">State</label>
            <input type="text" class="form-control" id="state" name="state" placeholder="Enter state">
          </div>

          <div class="mb-3">
            <label for="country">Country</label>
            <input type="text" class="form-control" id="country" name="country" placeholder="Enter country" value="India">
          </div>
        </div>
      </div>

      <!-- Full Width Fields -->
      <div class="row">
        <div class="col-12">
          <div class="mb-3">
            <label for="dob">Date of Birth</label>
            <input type="date" class="form-control" id="dob" name="dob">
          </div>

          <div class="mb-3">
            <label for="hostel">Hostel</label>
            <input type="text" class="form-control" id="hostel" name="hostel" placeholder="Hostel name / room">
          </div>

          <div class="mb-3">
            <label for="study">Study / Course</label>
            <input type="text" class="form-control" id="study" name="study" placeholder="What are you studying?">
          </div>

          <div class="mb-3">
            <label for="hobby">Hobby</label>
            <input type="text" class="form-control" id="hobby" name="hobby" placeholder="Your hobbies">
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-submit">
        <i class="fas fa-paper-plane"></i> Create Post
      </button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>