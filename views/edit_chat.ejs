<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Comment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .edit-container {
      background: #1e2937;
      border-radius: 20px;
      padding: 40px;
      max-width: 620px;
      width: 100%;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .page-title {
      text-align: center;
      color: #a855f7;
      font-size: 2.3rem;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .chat-info {
      text-align: center;
      background: #334155;
      padding: 16px;
      border-radius: 12px;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    label {
      color: #c4d0ff;
      font-weight: 600;
      margin-bottom: 10px;
      display: block;
    }

    .form-control {
      background: #334155;
      border: none;
      color: #e2e8f0;
      padding: 16px;
      border-radius: 12px;
      font-size: 1.05rem;
      resize: vertical;
      min-height: 160px;
    }

    .form-control:focus {
      background: #475569;
      box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.3);
      color: white;
    }

    .btn-update {
      width: 100%;
      padding: 14px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 12px;
      margin-top: 20px;
      background: #a855f7;
      border: none;
      transition: all 0.3s;
    }

    .btn-update:hover {
      background: #9333ea;
      transform: translateY(-3px);
    }
  </style>
</head>
<body>

  <div class="edit-container">
    <h1 class="page-title">
      <i class="fas fa-edit"></i> Edit Comment
    </h1>

    <div class="chat-info">
      <strong>ID:</strong> <%= chats._id %><br>
      From <strong>@<%= chats.from %></strong> 
      ? To <strong>@<%= chats.to %></strong>
    </div>

    <form action="/posts/chat/<%= chats._id %>?_method=PUT" method="POST">
      <label for="msg">Message</label>
      <textarea class="form-control" name="msg" id="msg" rows="6" required><%= chats.msg %></textarea>
      
      <button type="submit" class="btn btn-primary btn-update">
        <i class="fas fa-save"></i> Update Comment
      </button>
    </form>

    <div class="text-center mt-4">
      <a href="/posts/chat" class="text-muted">
        ? Back to All Chats
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>