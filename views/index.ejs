<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Post Management Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      padding: 30px 15px;
      min-height: 100vh;
    }

    .dashboard-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .dashboard-header h1 {
      color: #a855f7;
      font-size: 2.6rem;
      font-weight: 700;
    }

    .post-card {
      background: #1e2937;
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 20px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
    }

    .post-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 35px rgba(168, 85, 247, 0.15);
    }

    .post-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .username {
      font-size: 1.4rem;
      color: #67e8f9;
      font-weight: 600;
    }

    .post-id {
      color: #64748b;
      font-size: 0.95rem;
    }

    .action-buttons {
      margin-top: 15px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn-custom {
      padding: 10px 22px;
      border-radius: 50px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .bottom-actions {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 50px;
      flex-wrap: wrap;
    }

    .btn-big {
      padding: 14px 32px;
      font-size: 1.1rem;
      border-radius: 50px;
    }
  </style>
</head>
<body>

  <div class="dashboard-header">
    <h1><i class="fas fa-list-check"></i> Post Management</h1>
    <p class="text-muted">Total Posts: <strong><%= posts.length %></strong></p>
  </div>

  <div class="container">
    <% if (posts.length === 0) { %>
      <div class="text-center py-5">
        <i class="fas fa-folder-open fa-4x text-muted mb-3"></i>
        <h4>No posts found</h4>
      </div>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div class="post-card">
          <div class="post-header">
            <div>
              <div class="username">@<%= post.username %></div>
              <div class="post-id">ID: <%= post.id %></div>
            </div>

            <a href="/posts/<%= post.id %>" class="btn btn-primary btn-custom">
              <i class="fas fa-eye"></i> View Details
            </a>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- Bottom Action Buttons -->
    <div class="bottom-actions">
      <a href="/posts/new" class="btn btn-success btn-big">
        <i class="fas fa-plus"></i> Create New Post
      </a>
      <a href="/posts/chat" class="btn btn-info btn-big">
        <i class="fas fa-comments"></i> View All Chats
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>