<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Chat - Post <%= postId %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      padding-bottom: 90px;
    }

    .chat-header {
      background: #1e2937;
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid #334155;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .chat-header h1 {
      margin: 0;
      font-size: 1.8rem;
      color: #a855f7;
    }

    .chat-container {
      max-width: 800px;
      margin: 20px auto;
      padding: 0 15px;
    }

    .message {
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
    }

    .message-content {
      max-width: 75%;
      padding: 14px 18px;
      border-radius: 18px;
      position: relative;
    }

    .message.sent {
      align-items: flex-end;
    }

    .message.received {
      align-items: flex-start;
    }

    .message.sent .message-content {
      background: #7c3aed;
      color: white;
      border-bottom-right-radius: 4px;
    }

    .message.received .message-content {
      background: #1e2937;
      border-bottom-left-radius: 4px;
    }

    .message strong {
      display: block;
      margin-bottom: 4px;
      font-size: 0.95rem;
      color: #a5b4fc;
    }

    .message small {
      margin-top: 6px;
      font-size: 0.8rem;
      color: #64748b;
    }

    /* Fixed Input Form */
    .chat-input {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #1e2937;
      padding: 20px 15px;
      border-top: 1px solid #334155;
      box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.3);
      z-index: 1000;
    }

    .input-group {
      max-width: 800px;
      margin: 0 auto;
    }

    .delete-btn {
      font-size: 0.8rem;
      padding: 4px 10px;
      margin-top: 8px;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="chat-header">
    <h1>
      <i class="fas fa-comments"></i> Chat for Post
    </h1>
    <p class="mb-0 text-muted">Post ID: <strong><%= postId %></strong></p>
  </div>

  <div class="chat-container">

    <div class="chat-messages">
      <% if (messages.length === 0) { %>
        <div class="text-center text-muted py-5">
          <i class="fas fa-comment-dots fa-3x mb-3"></i>
          <p>No messages yet. Be the first to chat!</p>
        </div>
      <% } else { %>
        <% messages.forEach(msg => { %>
          <div class="message received">
            <div class="message-content">
              <strong>@<%= msg.from %></strong>
              <p class="mb-1"><%= msg.msg %></p>
              <small><%= msg.createdAt ? new Date(msg.createdAt).toLocaleString() : 'Just now' %></small>
              
              <form method="POST" action="/posts/<%= postId %>/chat/<%= msg._id %>?_method=DELETE" style="display: inline;">
                <button type="submit" class="btn btn-outline-danger btn-sm delete-btn"
                  onclick="return confirm('Delete this message?')">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

  </div>

  <!-- Fixed Chat Input -->
  <div class="chat-input">
    <form method="POST" action="/posts/<%= postId %>/chat" class="input-group">
      <div class="input-group">
        <input type="text" name="from" class="form-control" placeholder="Your name" required style="max-width: 180px;">
        <input type="text" name="msg" class="form-control" placeholder="Type your message..." required>
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-paper-plane"></i> Send
        </button>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>