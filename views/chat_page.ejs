<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Chats</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

  <style>
    body {
      background: #0f172a;
      color: #e2e8f0;
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
      padding: 30px 15px;
    }

    .page-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .page-header h1 {
      color: #a855f7;
      font-size: 2.5rem;
      font-weight: 700;
    }

    .chat-card {
      background: #1e2937;
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 20px;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
    }

    .chat-card:hover {
      transform: translateY(-5px);
    }

    .chat-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .user-info {
      font-size: 1.1rem;
    }

    .from-to {
      color: #67e8f9;
      font-weight: 600;
    }

    .message {
      background: #334155;
      padding: 16px;
      border-radius: 12px;
      margin: 15px 0;
      font-size: 1.05rem;
      line-height: 1.5;
    }

    .timestamp {
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .action-buttons {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 15px;
    }

    .btn-custom {
      padding: 8px 18px;
      border-radius: 50px;
      font-weight: 500;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="page-header">
      <h1><i class="fas fa-comments"></i> All Chats</h1>
      <p class="text-muted">Total Conversations: <strong><%= chats.length %></strong></p>
    </div>

    <div class="text-center mb-4">
      <a href="/posts/chat/new_chat" class="btn btn-success btn-lg">
        <i class="fas fa-plus"></i> Create New Comment
      </a>
    </div>

    <% if (chats.length === 0) { %>
      <div class="text-center py-5">
        <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
        <h4>No chats yet</h4>
      </div>
    <% } else { %>
      <% chats.forEach(ch => { %>
        <div class="chat-card">
          <div class="chat-header">
            <div class="user-info">
              <span class="from-to">@<%= ch.from %></span> 
              <i class="fas fa-arrow-right mx-2"></i> 
              <span class="from-to">@<%= ch.to %></span>
            </div>
            <small class="timestamp">
              <%= ch.created_at ? new Date(ch.created_at).toLocaleString() : 'No date' %>
            </small>
          </div>

          <div class="message">
            <%= ch.msg %>
          </div>

          <div class="action-buttons">
            <a href="/posts/chat/<%= ch._id %>/edit" class="btn btn-primary btn-custom">
              <i class="fas fa-edit"></i> Edit
            </a>
            <form method="POST" action="/posts/chat/<%= ch._id %>?_method=DELETE" style="display: inline;">
              <button type="submit" class="btn btn-danger btn-custom"
                onclick="return confirm('Delete this chat?')">
                <i class="fas fa-trash"></i> Delete
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>